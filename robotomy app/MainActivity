@OptIn(ExperimentalFoundationApi::class)
@Composable
private fun AdCarousel(modifier: Modifier = Modifier) {
    val ads = remember {
        listOf(
            AdItem(title = "9월 특별전 안내", bg = Color(0xFF1F6FEB)),
            AdItem(title = "도슨트 모집",   bg = Color(0xFFDB3B61)),
            AdItem(title = "상설전 오픈!",  bg = Color(0xFF7E57C2))
        )
    }
    val pager = rememberPagerState(pageCount = { ads.size })

    Card(
        modifier = modifier,
        shape = RoundedCornerShape(12.dp),
        colors = CardDefaults.cardColors(containerColor = Color.Black.copy(alpha = 0.12f)),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
    ) {
        HorizontalPager(state = pager) { page ->
            Box(
                Modifier
                    .fillMaxSize()
                    .background(ads[page].bg),
                contentAlignment = Alignment.CenterStart
            ) {
                Text(
                    text = ads[page].title,
                    color = Color.White,
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(start = 16.dp)
                )
            }
        }
    }
}
