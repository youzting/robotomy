/* ================== NavHost ================== */
@Composable
private fun AppNav() {
    val nav = rememberNavController()
    NavHost(navController = nav, startDestination = ROUTE_HOME) {

        composable(ROUTE_HOME) {
            HomeWithAds(
                onMenuClick = { key ->
                    when (key) {
                        "guide"   -> nav.navigate(ROUTE_GUIDE)
                        "explain" -> nav.navigate(ROUTE_EXPLAIN)
                        "floors"  -> nav.navigate(ROUTE_FLOORS)
                        "route"   -> nav.navigate(ROUTE_ROUTE)
                    }
                }
            )
        }

        composable(ROUTE_GUIDE)   { GuideScreen (onBack = { nav.popBackStack() }) }
        composable(ROUTE_EXPLAIN) { ExplainScreen(onBack = { nav.popBackStack() }) }
        composable(ROUTE_ROUTE)   { RouteScreen (onBack = { nav.popBackStack() }) }

        // ✅ 층별 정보: 평면도 화면으로 이동 콜백 연결
        composable(ROUTE_FLOORS) {
            FloorsScreen(
                onBack = { nav.popBackStack() },
                onOpenFloorMap = { floorId ->
                    nav.navigate("$ROUTE_FLOOR_MAP/$floorId")
                }
            )
        }

        // ✅ 층 평면도 (floorId 파라미터)
        composable("$ROUTE_FLOOR_MAP/{floorId}") { backStackEntry ->
            val floorId = backStackEntry.arguments?.getString("floorId") ?: "1F"
            FloorMapScreen(
                floorId = floorId,
                onBack = { nav.popBackStack() }
            )
        }
    }
}

/*---------------- 평면도 -----------------*/
@Composable
private fun FloorMapScreen(
    floorId: String,
    onBack: () -> Unit
) {
    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("$floorId 평면도") },
                navigationIcon = {
                    IconButton(onClick = onBack) { Icon(Icons.Filled.ArrowBack, null) }
                }
            )
        }
    ) { inner ->
        Box(Modifier.fillMaxSize().padding(inner), contentAlignment = Alignment.Center) {
            val imageRes = when (floorId) {
                "B1" -> R.drawable.floor_b1
                "1F" -> R.drawable.floor_b1
                "2F" -> R.drawable.floor_b1
                "3F" -> R.drawable.floor_b1
                else -> null
            }
            if (imageRes != null) {
                Image(
                    painter = painterResource(imageRes),
                    contentDescription = "$floorId floor map",
                    contentScale = ContentScale.Fit,
                    modifier = Modifier.fillMaxWidth().padding(16.dp)
                )
            } else {
                Text("평면도 이미지가 준비되지 않았습니다.", color = Color.Gray)
            }
        }
    }
}

