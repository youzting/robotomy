// 펼침 카드(층별 정보)
@Composable
private fun ExpandableCard(
    title: String,
    content: @Composable () -> Unit
) {
    var expanded by remember { mutableStateOf(false) }
    ElevatedCard(
        modifier = Modifier.fillMaxWidth().clickable { expanded = !expanded },
        shape = RoundedCornerShape(12.dp)
    ) {
        Column(Modifier.padding(16.dp)) {
            Row(
                Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(title, fontWeight = FontWeight.Bold)
                Text(if (expanded) "접기" else "펼치기", color = CARD_COLOR, fontWeight = FontWeight.SemiBold)
            }
            if (expanded) {
                Spacer(Modifier.height(8.dp))
                content()
            }
        }
    }
}

// 간단한 Chip UI (선택형)
@Composable
private fun ChoiceChip(label: String, selected: Boolean, onClick: () -> Unit) {
    Surface(
        color = if (selected) CARD_COLOR else Color(0xFFE6F4F1),
        contentColor = if (selected) Color.White else Color(0xFF14635D),
        shape = RoundedCornerShape(50),
        tonalElevation = if (selected) 2.dp else 0.dp,
        shadowElevation = if (selected) 2.dp else 0.dp,
        modifier = Modifier.padding(end = 8.dp, bottom = 8.dp).clickable(onClick = onClick)
    ) {
        Box(Modifier.padding(horizontal = 12.dp, vertical = 8.dp)) {
            Text(label, fontWeight = FontWeight.SemiBold)
        }
    }
}

// 행·열을 자동 줄바꿈으로 배치(간단 버전)
@Composable
private fun FlowWrap(content: @Composable RowScope.() -> Unit) {
    Row(Modifier.fillMaxWidth(), content = content)
}
